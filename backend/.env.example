DATABASE_URL="postgresql://docker:docker@localhost:5018/kairo?schema=public"
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"
# Senha padrão para novos utilizadores (passwordHash = bcrypt(DEFAULT_PASSWORD), firstLogin = true)
DEFAULT_PASSWORD="change-me-default-password"

# API externa (headers: key, nameapplication)
API_BASE_URL="https://example.com/api"
API_BASE_KEY="your-api-key"
API_BASE_NAME_APPLICATION="your-application-name"
