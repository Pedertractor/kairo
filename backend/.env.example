# Local development (host machine → published DB port)
DATABASE_URL="postgresql://docker:docker@localhost:5018/kairo?schema=public"
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
# Senha padrão para novos utilizadores (passwordHash = bcrypt(DEFAULT_PASSWORD), firstLogin = true)
DEFAULT_PASSWORD="change-me-default-password"

# API externa (headers: key, nameapplication)
API_BASE_URL="https://example.com/api"
API_BASE_KEY="your-api-key"
API_BASE_NAME_APPLICATION="your-application-name"

# Uploads de documentos das equipes (caminho relativo à pasta backend/)
UPLOAD_DIR="uploads"

# Orion Application Event (painel de autenticação/atividade)
ORION_URL=http://localhost:6161/api/applications/events
ORION_APP_TOKEN=uuid-da-aplicacao.segredo-gerado-no-orion

# Webhook para Solicitação de Engenharia Mecânica (omita ambas para desativar).
# Produção: URL completa do backend Solicitação acessível pelo servidor Kairo,
# por exemplo https://backend-solicitacao.seu-dominio.com/api/webhooks/kairo.
# Docker Desktop com os Compose atuais: http://host.docker.internal:5025/api/webhooks/kairo.
SOLICITATION_WEBHOOK_URL=http://localhost:3142/api/webhooks/kairo
# Mesmo segredo aleatório de KAIRO_WEBHOOK_SECRET no Solicitação (mínimo 32 caracteres).
SOLICITATION_WEBHOOK_SECRET=substitua-por-um-segredo-aleatorio-de-64-caracteres

# Docker Compose (backend/docker-compose.yml)
POSTGRES_USER=docker
POSTGRES_PASSWORD=docker
POSTGRES_DB=kairo
API_PORT=5019
DB_PORT=5018
